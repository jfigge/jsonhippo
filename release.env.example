# JsonHippo — release signing & notarization environment
#
# Credentials for SIGNED local installer builds (`make dist-mac`, `make
# dist-win`). Copy this file to `release.env` (git-ignored) and fill it in:
#
#   cp release.env.example release.env
#
# The Makefile `-include`s release.env and exports each of these names only
# when it is non-empty, the same way Rest Hippo's does. In CI the same names
# come from repository secrets (.github/workflows/release.yml), never from this
# file.
#
# THE CERTIFICATES ARE THE HERD'S. A Developer ID Application certificate signs
# any app its team ships, so there is nothing JsonHippo-specific to create for
# macOS: Rest Hippo's (and Jump Hippo's) release.env already holds a working
# set, and the Makefile can read it in place rather than copying it:
#
#   make dist-mac RELEASE_ENV=../resthippo/release.env
#   make sync-mac RELEASE_ENV=../resthippo/release.env   # → this repo's secrets
#
# Chip Hippo keeps the same certificate as a file (certs/DeveloperID.p12) and
# notarizes with an App Store Connect API key instead; option B below.
#
# Everything is OPTIONAL: with nothing set, the build still succeeds, unsigned
# and un-notarized. Never commit real values.

# ── macOS — Developer ID signing ──────────────────────────────────────────────
# The "Developer ID Application" certificate and its key, exported as a .p12,
# base64-encoded (or give the path to the .p12 file instead):
#   base64 -i DeveloperID.p12 | pbcopy
# Leave both blank to let electron-builder find the identity in your login
# keychain instead.
CSC_LINK=
CSC_KEY_PASSWORD=

# Set to false to force an unsigned build whatever the keychain holds.
# CSC_IDENTITY_AUTO_DISCOVERY=false

# ── macOS — notarization (Apple notarytool) ───────────────────────────────────
# Option A — Apple ID + app-specific password + team id (Rest Hippo's route).
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Option B — App Store Connect API key (Chip Hippo's route). APPLE_API_KEY is
# the PATH to AuthKey_<id>.p8. Use option A or option B, not both.
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# ── Windows — Authenticode signing ────────────────────────────────────────────
# No hippo has a Windows code-signing certificate yet: Rest Hippo's CI route is
# SignPath Foundation (not configured), and Chip Hippo ships unsigned. If one is
# bought, its .pfx goes here, base64-encoded or as a path, and electron-builder
# signs `make dist-win` with it.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
