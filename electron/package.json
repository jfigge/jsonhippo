{
  "name": "jsonhippo-desktop",
  "productName": "JsonHippo",
  "version": "0.0.0",
  "private": true,
  "description": "A JSON viewer that tells you exactly where it broke — desktop build.",
  "license": "GPL-3.0-or-later",
  "author": "Jason Figge",
  "homepage": "https://hippoherd.com/jsonhippo/",
  "main": "main.js",
  "desktopName": "jsonhippo.desktop",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^42.7.0",
    "electron-builder": "~26.17.0"
  },
  "build": {
    "appId": "com.hippoherd.jsonhippo",
    "productName": "JsonHippo",
    "copyright": "Copyright © 2026 Jason Figge",
    "artifactName": "JsonHippo-${version}-${arch}.${ext}",
    "publish": null,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "icons"
    },
    "files": [
      "main.js",
      "policy.js",
      "package.json",
      "icons/linux/512x512.png",
      "web/**/*"
    ],
    "mac": {
      "icon": "icons/mac.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "JsonHippo-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false
    },
    "linux": {
      "icon": "icons/linux",
      "category": "Development",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
